+#[test]
+fn acknowledged_write_with_partial_cache_failure_remains_an_error() {
+    struct PartialCache {
+        credential: MockCredential,
+        fail_cleanup: bool,
+    }
+    impl CredentialApi for PartialCache {
+        fn set_secret(&self, value: &[u8]) -> keyring::Result<()> {
+            self.credential.set_secret(value)?;
+            Err(platform_error(io::ErrorKind::PermissionDenied, "link failed"))
+        }
+
+        fn get_secret(&self) -> keyring::Result<Vec<u8>> {
+            self.credential.get_secret()
+        }
+
+        fn delete_credential(&self) -> keyring::Result<()> {
+            if self.fail_cleanup {
+                Err(platform_error(io::ErrorKind::PermissionDenied, "invalidate failed"))
+            } else {
+                self.credential.delete_credential()
+            }
+        }
+
+        fn as_any(&self) -> &dyn std::any::Any {
+            self
+        }
+    }
+
+    for fail_cleanup in [false, true] {
+        let cache = PartialCache {
+            credential: MockCredential::default(),
+            fail_cleanup,
+        };
+        cache.credential.set_password("previous").unwrap();
+        let error = finish_refresh_save(&cache, "rotated", true, Ok(())).unwrap_err();
+        let message = error.to_string();
+        assert!(message.contains("write acknowledged; kernelcache update failed"));
+        assert_eq!(message.contains("invalidation failed"), fail_cleanup);
+        assert_eq!(io_kind(error), io::ErrorKind::PermissionDenied);
+        if !fail_cleanup {
+            assert!(matches!(cache.get_secret(), Err(KeyringError::NoEntry)));
+        }
+    }
+    assert!(rejected_write(&SecretServiceError::Locked));
+    assert!(rejected_write(&SecretServiceError::ZbusFdo(
+        zbus::fdo::Error::AccessDenied("denied".to_string())
+    )));
+    assert!(!rejected_write(&SecretServiceError::ZbusFdo(
+        zbus::fdo::Error::NoReply("unknown".to_string())
+    )));
+}
