+pub(super) fn save_for_refresh(
+    service: &str,
+    account: &str,
+    value: &str,
+) -> keyring::Result<()> {
+    if value.is_empty() {
+        return Err(KeyringError::Invalid(
+            "secret".to_string(),
+            "cannot be empty".to_string(),
+        ));
+    }
+    let cache = KeyutilsCredential::new_with_target(None, service, account)?;
+    let write_started = Cell::new(false);
+    let result = with_deadline(write_password(service, account, value, &write_started), async {
+        async_io::Timer::after(READ_TIMEOUT).await;
+    });
+    finish_refresh_save(&cache, value, write_started.get(), result)
+}
+
+fn finish_refresh_save(
+    cache: &impl keyring::credential::CredentialApi,
+    value: &str,
+    write_started: bool,
+    result: keyring::Result<()>,
+) -> keyring::Result<()> {
+    match result {
+        Ok(()) => cache.set_password(value).map_err(|error| {
+            refresh_save_error(
+                cache,
+                "Secret Service refresh write acknowledged; kernelcache update failed",
+                error,
+            )
+        }),
+        Err(error) if write_started => Err(refresh_save_error(
+            cache,
+            "Secret Service refresh write outcome unknown; no persistence success acknowledged",
+            error,
+        )),
+        Err(error) => Err(error),
+    }
+}
+
+#[derive(Debug)]
+struct RefreshSaveError {
+    message: &'static str,
+    cause: CredentialStoreError,
+    cleanup_error: Option<CredentialStoreError>,
+}
+
+impl fmt::Display for RefreshSaveError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}: {}; ", self.message, self.cause)?;
+        if let Some(error) = &self.cleanup_error {
+            write!(formatter, "targeted kernelcache invalidation failed: {error}")
+        } else {
+            formatter.write_str(
+                "targeted kernelcache invalidation accepted or entry absent; immediate cache coherence is unconfirmed",
+            )
+        }
+    }
+}
+
+impl std::error::Error for RefreshSaveError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.cause)
+    }
+}
+
+fn refresh_save_error(
+    cache: &impl keyring::credential::CredentialApi,
+    message: &'static str,
+    error: KeyringError,
+) -> KeyringError {
+    let cause = CredentialStoreError::new(error);
+    let kind = crate::error_kind::classify(&cause);
+    let cleanup_error = match cache.delete_credential() {
+        Ok(()) | Err(KeyringError::NoEntry) => None,
+        Err(error) => Some(CredentialStoreError::new(error)),
+    };
+    KeyringError::PlatformFailure(Box::new(io::Error::new(
+        kind,
+        RefreshSaveError {
+            message,
+            cause,
+            cleanup_error,
+        },
+    )))
+}
+
+async fn write_password(
+    service: &str,
+    account: &str,
+    value: &str,
+    write_started: &Cell<bool>,
+) -> keyring::Result<()> {
+    let ss = SecretService::connect(EncryptionType::Dh)
+        .await
+        .map_err(decode_error)?;
+    let attributes = HashMap::from([
+        ("target", "default"),
+        ("service", service),
+        ("username", account),
+    ]);
+    let matches = ss.search_items(attributes).await.map_err(decode_error)?;
+    if let Some(item) = unique_unlocked(matches)? {
+        return write_item(&item, value, write_started).await;
+    }
+    let collection = match ss.get_default_collection().await {
+        Ok(collection) => collection,
+        Err(SecretServiceError::NoResult) => return Err(KeyringError::NoEntry),
+        Err(error) => return Err(decode_error(error)),
+    };
+    let attributes = HashMap::from([("service", service), ("username", account)]);
+    let items = collection
+        .search_items(attributes)
+        .await
+        .map_err(decode_error)?;
+    let item = unique_unlocked(SearchItemsResult {
+        unlocked: items,
+        locked: Vec::new(),
+    })?
+    .ok_or(KeyringError::NoEntry)?;
+    write_item(&item, value, write_started).await
+}
+
+async fn write_item(
+    item: &Item<'_>,
+    value: &str,
+    write_started: &Cell<bool>,
+) -> keyring::Result<()> {
+    item.ensure_unlocked().await.map_err(decode_error)?;
+    // A missing SetSecret reply cannot undo a write already received by the service.
+    write_started.set(true);
+    match item.set_secret(value.as_bytes(), "text/plain").await {
+        Ok(()) => Ok(()),
+        Err(error) => {
+            if rejected_write(&error) {
+                write_started.set(false);
+            }
+            Err(decode_error(error))
+        }
+    }
+}
+
+fn rejected_write(error: &SecretServiceError) -> bool {
+    match error {
+        SecretServiceError::Locked => true,
+        SecretServiceError::Zbus(zbus::Error::MethodError(name, _, _)) => matches!(
+            name.as_str(),
+            "org.freedesktop.Secret.Error.IsLocked"
+                | "org.freedesktop.Secret.Error.NoSuchObject"
+                | "org.freedesktop.DBus.Error.UnknownObject"
+                | "org.freedesktop.DBus.Error.AccessDenied"
+                | "org.freedesktop.DBus.Error.AuthFailed"
+        ),
+        SecretServiceError::ZbusFdo(error) => matches!(
+            error,
+            zbus::fdo::Error::AccessDenied(_)
+                | zbus::fdo::Error::AuthFailed(_)
+                | zbus::fdo::Error::UnknownObject(_)
+        ),
+        SecretServiceError::Zbus(zbus::Error::FDO(error)) => matches!(
+            error.as_ref(),
+            zbus::fdo::Error::AccessDenied(_)
+                | zbus::fdo::Error::AuthFailed(_)
+                | zbus::fdo::Error::UnknownObject(_)
+        ),
+        _ => false,
+    }
+}
