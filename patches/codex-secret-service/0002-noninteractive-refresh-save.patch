+#[test]
+fn refresh_save_updates_cache_only_after_confirmed_persistence() {
+    let cache = MockCredential::default();
+    cache.set_password("previous").unwrap();
+    for error in [
+        KeyringError::NoEntry,
+        decode_error(SecretServiceError::Locked),
+        decode_error(SecretServiceError::Unavailable),
+        platform_error(io::ErrorKind::PermissionDenied, "denied"),
+        platform_error(io::ErrorKind::TimedOut, "before SetSecret"),
+        platform_error(io::ErrorKind::InvalidData, "ambiguous"),
+    ] {
+        finish_refresh_save(&cache, "unconfirmed", false, Err(error)).unwrap_err();
+        assert_eq!(cache.get_password().unwrap(), "previous");
+    }
+    let original = "  rotated\nvalue 🦀\0";
+    finish_refresh_save(&cache, original, true, Ok(())).unwrap();
+    assert_eq!(cache.get_secret().unwrap(), original.as_bytes());
+}
