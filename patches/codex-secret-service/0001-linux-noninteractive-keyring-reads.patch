+use super::*;
+use crate::CredentialStoreError;
+use std::cell::Cell;
+use std::future::pending;
+use std::rc::Rc;
+
+fn io_kind(error: KeyringError) -> io::ErrorKind {
+    io::Error::from(CredentialStoreError::new(error)).kind()
+}
+
+#[test]
+fn distinguishes_missing_locked_ambiguous_and_unique_unlocked() {
+    assert_eq!(
+        unique_unlocked::<String>(SearchItemsResult {
+            unlocked: Vec::new(),
+            locked: Vec::new(),
+        })
+        .unwrap(),
+        None
+    );
+    assert_eq!(
+        io_kind(
+            unique_unlocked(SearchItemsResult {
+                unlocked: Vec::<String>::new(),
+                locked: vec!["locked".to_string()],
+            })
+            .unwrap_err()
+        ),
+        io::ErrorKind::WouldBlock
+    );
+    for (unlocked, locked) in [(2, 0), (1, 1), (0, 2)] {
+        assert_eq!(
+            io_kind(
+                unique_unlocked(SearchItemsResult {
+                    unlocked: vec![(); unlocked],
+                    locked: vec![(); locked],
+                })
+                .unwrap_err()
+            ),
+            io::ErrorKind::InvalidData
+        );
+    }
+    let original = "  token\nwith whitespace and 🦀\0";
+    assert_eq!(
+        unique_unlocked(SearchItemsResult {
+            unlocked: vec![original.to_string()],
+            locked: Vec::new(),
+        })
+        .unwrap()
+        .as_deref(),
+        Some(original)
+    );
+    assert_eq!(decode_password(original.as_bytes().to_vec()).unwrap(), original);
+    assert!(matches!(
+        decode_password(vec![0xff]),
+        Err(KeyringError::BadEncoding(bytes)) if bytes == [0xff]
+    ));
+}
+
+#[test]
+fn classifies_native_errors_without_treating_them_as_missing() {
+    for (error, expected) in [
+        (SecretServiceError::Locked, io::ErrorKind::WouldBlock),
+        (SecretServiceError::Unavailable, io::ErrorKind::NotConnected),
+        (
+            SecretServiceError::ZbusFdo(zbus::fdo::Error::AccessDenied("denied".to_string())),
+            io::ErrorKind::PermissionDenied,
+        ),
+        (
+            SecretServiceError::ZbusFdo(zbus::fdo::Error::ServiceUnknown("absent".to_string())),
+            io::ErrorKind::NotConnected,
+        ),
+        (
+            SecretServiceError::ZbusFdo(zbus::fdo::Error::NoReply("no reply".to_string())),
+            io::ErrorKind::TimedOut,
+        ),
+    ] {
+        assert_eq!(io_kind(decode_error(error)), expected);
+    }
+    for (name, expected) in [
+        ("org.freedesktop.DBus.Error.AccessDenied", Some(io::ErrorKind::PermissionDenied)),
+        ("org.freedesktop.DBus.Error.ServiceUnknown", Some(io::ErrorKind::NotConnected)),
+        ("org.freedesktop.DBus.Error.NoReply", Some(io::ErrorKind::TimedOut)),
+        ("org.freedesktop.Secret.Error.NoSuchObject", None),
+    ] {
+        assert_eq!(method_error_kind(name), expected);
+    }
+}
+
+#[test]
+fn deadline_drops_a_pending_read_instead_of_leaving_a_blocking_job() {
+    struct ReadGuard(Rc<Cell<bool>>);
+    impl Drop for ReadGuard {
+        fn drop(&mut self) {
+            self.0.set(true);
+        }
+    }
+
+    let started = Rc::new(Cell::new(false));
+    let dropped = Rc::new(Cell::new(false));
+    let guard = ReadGuard(Rc::clone(&dropped));
+    let read = async {
+        let _guard = guard;
+        started.set(true);
+        pending::<keyring::Result<()>>().await
+    };
+    let deadline = poll_fn(|context| {
+        if started.get() {
+            Poll::Ready(())
+        } else {
+            context.waker().wake_by_ref();
+            Poll::Pending
+        }
+    });
+    assert_eq!(io_kind(with_deadline(read, deadline).unwrap_err()), io::ErrorKind::TimedOut);
+    assert!(started.get());
+    assert!(dropped.get());
+    assert_eq!(with_deadline(async { Ok(42) }, pending()).unwrap(), 42);
+}
