+use keyring::Error as KeyringError;
+use keyring::credential::CredentialApi as _;
+use keyring::keyutils::KeyutilsCredential;
+use secret_service::EncryptionType;
+use secret_service::Error as SecretServiceError;
+use secret_service::SearchItemsResult;
+use secret_service::SecretService;
+use std::collections::HashMap;
+use std::future::Future;
+use std::future::poll_fn;
+use std::io;
+use std::pin::pin;
+use std::task::Poll;
+use std::time::Duration;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(2);
+
+pub(super) fn get_password(service: &str, account: &str) -> keyring::Result<String> {
+    let cache = KeyutilsCredential::new_with_target(None, service, account)?;
+    if let Ok(password) = cache.get_password() {
+        return Ok(password);
+    }
+
+    let password = with_deadline(read_password(service, account), async {
+        async_io::Timer::after(READ_TIMEOUT).await;
+    })?;
+    cache.set_password(&password)?;
+    Ok(password)
+}
+
+fn with_deadline<T>(
+    operation: impl Future<Output = keyring::Result<T>>,
+    deadline: impl Future<Output = ()>,
+) -> keyring::Result<T> {
+    let mut operation = pin!(operation);
+    let mut deadline = pin!(deadline);
+    // The deadline drops the actual async read instead of detaching a blocking job.
+    async_io::block_on(poll_fn(|context| {
+        if deadline.as_mut().poll(context).is_ready() {
+            return Poll::Ready(Err(platform_error(
+                io::ErrorKind::TimedOut,
+                "Secret Service credential read timed out",
+            )));
+        }
+        operation.as_mut().poll(context)
+    }))
+}
+
+async fn read_password(service: &str, account: &str) -> keyring::Result<String> {
+    let ss = SecretService::connect(EncryptionType::Dh)
+        .await
+        .map_err(decode_error)?;
+    let attributes = HashMap::from([
+        ("target", "default"),
+        ("service", service),
+        ("username", account),
+    ]);
+    let matches = ss.search_items(attributes).await.map_err(decode_error)?;
+    let item = if let Some(item) = unique_unlocked(matches)? {
+        item
+    } else {
+        // Match keyring 3.6.3's fallback: omit target only inside the default collection.
+        let collection = match ss.get_default_collection().await {
+            Ok(collection) => collection,
+            Err(SecretServiceError::NoResult) => return Err(KeyringError::NoEntry),
+            Err(error) => return Err(decode_error(error)),
+        };
+        let attributes = HashMap::from([("service", service), ("username", account)]);
+        let items = collection
+            .search_items(attributes)
+            .await
+            .map_err(decode_error)?;
+        let item = unique_unlocked(SearchItemsResult {
+            unlocked: items,
+            locked: Vec::new(),
+        })?
+        .ok_or(KeyringError::NoEntry)?;
+        item.ensure_unlocked().await.map_err(decode_error)?;
+        return decode_password(item.get_secret().await.map_err(decode_error)?);
+    };
+    item.ensure_unlocked().await.map_err(decode_error)?;
+    decode_password(item.get_secret().await.map_err(decode_error)?)
+}
+
+fn unique_unlocked<T>(mut matches: SearchItemsResult<T>) -> keyring::Result<Option<T>> {
+    match matches.unlocked.len() + matches.locked.len() {
+        0 => Ok(None),
+        1 if matches.locked.is_empty() => Ok(matches.unlocked.pop()),
+        1 => Err(KeyringError::NoStorageAccess(Box::new(
+            SecretServiceError::Locked,
+        ))),
+        _ => Err(platform_error(
+            io::ErrorKind::InvalidData,
+            "Multiple matching Secret Service credentials",
+        )),
+    }
+}
+
+fn decode_password(bytes: Vec<u8>) -> keyring::Result<String> {
+    String::from_utf8(bytes).map_err(|error| KeyringError::BadEncoding(error.into_bytes()))
+}
+
+fn decode_error(error: SecretServiceError) -> KeyringError {
+    match &error {
+        SecretServiceError::Locked => return KeyringError::NoStorageAccess(Box::new(error)),
+        SecretServiceError::Zbus(zbus::Error::MethodError(name, _, _))
+            if name.as_str() == "org.freedesktop.Secret.Error.IsLocked" =>
+        {
+            return KeyringError::NoStorageAccess(Box::new(SecretServiceError::Locked));
+        }
+        SecretServiceError::Zbus(zbus::Error::MethodError(name, _, _)) => {
+            if let Some(kind) = method_error_kind(name.as_str()) {
+                return platform_error(kind, "Secret Service credential read failed");
+            }
+        }
+        SecretServiceError::ZbusFdo(error) => {
+            if let Some(kind) = fdo_error_kind(error) {
+                return platform_error(kind, "Secret Service credential read failed");
+            }
+        }
+        SecretServiceError::Zbus(zbus::Error::FDO(error)) => {
+            if let Some(kind) = fdo_error_kind(error) {
+                return platform_error(kind, "Secret Service credential read failed");
+            }
+        }
+        _ => {}
+    }
+    KeyringError::PlatformFailure(Box::new(error))
+}
+
+fn fdo_error_kind(error: &zbus::fdo::Error) -> Option<io::ErrorKind> {
+    use zbus::fdo::Error;
+    match error {
+        Error::AccessDenied(_) | Error::AuthFailed(_) => Some(io::ErrorKind::PermissionDenied),
+        Error::ServiceUnknown(_) | Error::NameHasNoOwner(_) | Error::Disconnected(_) => {
+            Some(io::ErrorKind::NotConnected)
+        }
+        Error::NoReply(_) | Error::Timeout(_) | Error::TimedOut(_) => Some(io::ErrorKind::TimedOut),
+        _ => None,
+    }
+}
+
+fn method_error_kind(name: &str) -> Option<io::ErrorKind> {
+    match name {
+        "org.freedesktop.DBus.Error.AccessDenied" | "org.freedesktop.DBus.Error.AuthFailed" => {
+            Some(io::ErrorKind::PermissionDenied)
+        }
+        "org.freedesktop.DBus.Error.ServiceUnknown"
+        | "org.freedesktop.DBus.Error.NameHasNoOwner"
+        | "org.freedesktop.DBus.Error.Disconnected" => Some(io::ErrorKind::NotConnected),
+        "org.freedesktop.DBus.Error.NoReply"
+        | "org.freedesktop.DBus.Error.Timeout"
+        | "org.freedesktop.DBus.Error.TimedOut" => Some(io::ErrorKind::TimedOut),
+        _ => None,
+    }
+}
+
+fn platform_error(kind: io::ErrorKind, message: &'static str) -> KeyringError {
+    KeyringError::PlatformFailure(Box::new(io::Error::new(kind, message)))
+}
