---
interface Props {
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { alt, sizes, eager = false } = Astro.props;
---

<img
  src="/crew-native.svg"
  {sizes}
  {alt}
  width="960"
  height="1200"
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
/>
