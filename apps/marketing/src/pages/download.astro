---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL, NIGHTLY_RELEASES_URL } from "../lib/releases";
import { NIXOS_INSTALL_URL } from "../lib/site";

const platforms = [
  { name: "Windows", arch: "x64", format: "Windows installer", url: RELEASES_URL },
  { name: "Linux", arch: "x64", format: "AppImage", url: RELEASES_URL },
  { name: "NixOS", arch: "x64", format: "Package and installation guide", url: NIXOS_INSTALL_URL },
  { name: "Android", arch: "ARM64", format: "APK", url: RELEASES_URL },
];
---

<Layout
  title="Download | Crew"
  description="Download Crew for Windows x64, Linux x64, NixOS, and Android ARM64."
>
  <div class="download-page">
    <header class="download-head">
      <div class="head-inner" data-rise>
        <img src="/crew-native.svg" width="64" height="64" loading="eager" alt="" decoding="async" />
        <h1 class="heading">Download Crew</h1>
      </div>
      <p class="head-meta" data-rise style="--d:90ms">
        <a href={RELEASES_URL}>Releases</a>
        <span aria-hidden="true"> · </span>
        <a href={NIGHTLY_RELEASES_URL}>Nightly previews</a>
      </p>
    </header>

    <div class="platforms">
      {platforms.map((platform) => (
        <section class="platform-section" data-rise style="--d:180ms">
          <h2 class="platform-name">{platform.name}</h2>
          <a class="download-card" href={platform.url}>
            <img src="/crew-native.svg" width="28" height="28" loading="lazy" alt="" decoding="async" />
            <span class="card-text">
              <span class="card-arch">{platform.arch}</span>
              <span class="card-format">{platform.format}</span>
            </span>
            <span class="card-action">{platform.name === "NixOS" ? "Install guide" : "View releases"}<span aria-hidden="true"> ↗</span></span>
          </a>
        </section>
      ))}
    </div>

    <p class="releases-link" data-rise style="--d:270ms">
      Crew builds are published on the <a href={RELEASES_URL}>Morrowbyte GitHub releases page</a>.
      macOS and iOS production builds are not available for this fork.
    </p>
  </div>
</Layout>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.5rem 4rem;
  }

  .download-head {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9vh 1.5rem 2.5rem;
    margin-bottom: 2rem;
  }

  .head-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .head-inner img {
    flex-shrink: 0;
  }

  .heading {
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .head-meta {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .head-meta a,
  .releases-link a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .platforms {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .platform-name {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-weight: 500;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .download-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-strong);
  }

  .download-card img {
    flex-shrink: 0;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-arch {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .card-format {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .card-action {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--fg-muted);
    text-align: right;
  }

  .releases-link {
    max-width: 720px;
    margin-top: 3rem;
    font-size: 0.825rem;
    color: var(--fg-dim);
  }

  @media (max-width: 640px) {
    .download-page {
      padding: 0 1.25rem 4rem;
    }

    .download-head {
      padding: 6vh 1.25rem 2rem;
    }

    .head-inner {
      flex-direction: column;
      text-align: center;
    }

    .card-action {
      max-width: 6rem;
    }
  }
</style>
